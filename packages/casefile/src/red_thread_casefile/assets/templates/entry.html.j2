{# A case file entry: its ref, claim and verdict, citation, notes and diagram. #}
{% import 'templates/macros.html.j2' as draw %}

{% macro state(finding) %}
  {% if finding %}
<span class="state" data-state="{{ finding.state }}" title="The citation at the last check">{{ finding|state_label }}</span>
  {%- endif %}
{% endmacro %}

{% macro cite(citation) %}
  {% if citation is not none %}
    {% set target = citation.target %}
    {% set tools %}{{ state(citation.finding) }}<button type="button" class="copy" data-copy="{{ target }}">Copy</button>{% endset %}
    {% if citation.is_url %}
<p class="cite"><a href="{{ target|safe_url }}" rel="noreferrer">{{ target }}</a>{{ tools }}</p>
    {%- else %}
<p class="cite"><code>{{ target }}</code>{{ tools }}</p>
      {%- if citation.quote is not none %}<pre class="quote"><code>{{ citation.quote }}</code></pre>{% endif %}
    {%- endif %}
  {%- endif %}
{% endmacro %}

{% macro notes(entry) -%}
<ul class="notes"><li class="stamp">round {{ entry.round }}</li><li class="stamp"><time datetime="{{ entry.at }}">{{ entry.at|date_of }}</time></li>
  {%- for flag in entry.flags %}<li class="flag">{{ flag }}</li>{% endfor %}
  {%- for note in entry.notes %}<li>{{ note.text }}</li>{% endfor -%}
</ul>
{%- endmacro %}

{% macro claim(entry) -%}
<p class="claim">
  {%- if entry.verdict %}<span class="verdict" data-verdict="{{ entry.verdict }}">{{ entry.verdict }}</span> {% endif -%}
  {{ draw.line(entry.claim) }}</p>
{%- endmacro %}

{% macro entry(entry) -%}
<li class="entry" id="{{ entry.ref }}" data-kind="{{ entry.kind }}" data-thread="{{ entry.thread or '' }}">
  {{- draw.ref(entry.ref) }}<div>{{ claim(entry) }}{{ cite(entry.citation) }}{{ notes(entry) }}
  {%- if entry.diagram is not none %}<pre class="mermaid">{{ entry.diagram }}</pre>{% endif -%}
</div></li>
{%- endmacro %}
