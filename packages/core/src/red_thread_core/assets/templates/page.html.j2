{% import 'templates/macros.html.j2' as draw %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="claude:viewport-fit-sides" content="cover">
<title>{{ page.document.title }}</title>
<style>
{% include 'page.css' +%}
</style>
<script src="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss-browser/4.3.5/index.global.js" integrity="sha512-Rp5E7b9f/JNWhWQyH0414HSGMmXvvownsOsJALy5TaG6r1BbrZ6rd5GDCW+Nxjv6l7EDnue27ZxSSLWwf3f7vQ==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<style type="text/tailwindcss">
{% include 'tailwind.css' +%}
</style>
</head>
<body>
<div class="layout">
<aside class="rail">
<header class="masthead">
<h1>{{ page.document.title }}</h1>
{% if page.document.summary %}
<ul class="meta">
  {%- for line in page.document.summary %}<li>{{ draw.line(line) }}</li>{% endfor -%}
</ul>
{% endif %}
{% if page.document.facts %}
<dl class="facts">
  {%- for fact in page.document.facts %}{{ draw.fact(fact) }}{% endfor -%}
</dl>
{% endif %}
</header>
{% if page.document.sections %}
<nav class="toolbar" aria-label="Page controls">
  {%- for row in page.chip_rows %}{{ draw.chips(row) }}{% endfor -%}
  <button type="button" class="tool" data-fold>Collapse all</button></nav>
{% endif %}
{% if page.has_contents %}
<nav class="contents" aria-label="Sections"><ol>
  {%- for section in page.sections %}<li><a href="#{{ section.title|anchor }}">{{ section.title }}</a></li>{% endfor -%}
</ol></nav>
{% endif %}
{% if page.document.terms %}
<details class="terms"><summary>What the words on this page mean</summary><dl>
  {%- for term in page.document.terms %}<div><dt>{{ term.word }}</dt><dd>{{ term.meaning }}</dd></div>{% endfor -%}
</dl></details>
{% endif %}
</aside>
<main class="content">
{% for group in page.groups %}
  {% if group.column %}
<div class="columns">
  {% endif %}
  {% for section in group.sections %}{{ draw.fold(section) }}{% endfor %}
  {% if group.column %}
</div>
  {% endif %}
{% endfor %}
</main>
</div>
<p id="status" role="status" class="sr-only"></p>
<script src="https://cdnjs.cloudflare.com/ajax/libs/mermaid/12.3.0/mermaid.min.js" integrity="sha512-CaEn6DWYJ1MM0mFAT9nvJzd3z5gPsXTM7wzprb8wx615WzTnTSrGrbKkZUqe1s24lpW27X4HlIrSFvQm/ykqZA==" crossorigin="anonymous" referrerpolicy="no-referrer" defer></script>
<script>
{% include 'page.js' +%}
</script>
</body>
</html>
